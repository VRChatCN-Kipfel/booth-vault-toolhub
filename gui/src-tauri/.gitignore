# will have compiled files and executables
/target/

# Build-time staged CLI binaries (tauri beforeBundleCommand copies booth*.exe here for bundle.resources)
# `.gitkeep` 占位保证 tauri-build 编译期资源校验通过；真 CLI 由钩子写入
/resources/*
!/resources/.gitkeep

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas
